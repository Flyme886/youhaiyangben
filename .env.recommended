# 有害样本 - 推荐配置（基于任务执行分析）

# ============ 基础配置 ============
APP_PASSWORD=change-this-password
HOST=0.0.0.0
PORT=8787

# ============ 路径配置 ============
TASK_ROOT=/opt/harmful-sample-web/data/tasks
DATABASE_PATH=/opt/harmful-sample-web/data/app.db
STORAGE_STATE_PATH=/opt/harmful-sample-web/data/storage_state.json

# ============ Python/Node 配置 ============
PYTHON_BIN=/usr/bin/python3
NODE_BIN=/usr/bin/node

# ============ 关键修复：验证码阈值 ============
# 原值: CAPTCHA_PAUSE_THRESHOLD=1  (太严格，导致任务提前暂停)
# 改为: CAPTCHA_PAUSE_THRESHOLD=20 (允许更多验证码)
#
# 含义: 当检测到 20 条验证码时暂停，第 21 条时停止处理
#      (而不是检测到 1 条就暂停)
#
# 效果:
#   - 更多 URL 能被成功处理
#   - Word 文件能正常生成
#   - 任务不会过早暂停
CAPTCHA_PAUSE_THRESHOLD=20

# ============ 爬虫配置 ============
CAPTURE_ENGINE=playwright        # playwright / drission
CAPTURE_PROFILE=desktop          # desktop / mobile
CAPTURE_HEADLESS=true           # 无头模式
CAPTURE_FULL_PAGE=true          # 捕获完整页面
TASK_TIMEOUT_SECONDS=7200       # 2 小时超时

# ============ 反爬虫对抗配置 ============
# Drission 引擎特定的域名配置（用于更好的反爬虫）
# 这些域名会使用 Drission 引擎而不是 Playwright
DRISSION_DOMAINS=xiaohongshu.com,weibo.com

# ============ 会话和安全 ============
SESSION_SECRET=harmful-sample-web-local-secret

# ============ 登录态文件 ============
# 如果上传了 storage_state.json，爬虫会自动使用它来模拟登录用户
# 存放位置: /opt/harmful-sample-web/data/storage_state.json
# 这会使 login_required 的 URL 变为可访问

# ============ 技能目录 ============
SKILL_DIR=/opt/harmful-sample-web/skills/harmful_sample

# ============ 调整建议 ============
# 如果任务仍然失败，尝试：
#
# 1. 提高超时时间
#    TASK_TIMEOUT_SECONDS=10800  (3 小时)
#
# 2. 禁用无头模式（某些页面在有头模式下渲染更好）
#    CAPTURE_HEADLESS=false
#
# 3. 添加登录态（见下文）
#    上传 storage_state.json 文件
#
# 4. 增加更多使用 Drission 的域名
#    DRISSION_DOMAINS=xiaohongshu.com,weibo.com,toutiao.com

# ============ 登录态获取方法 ============
#
# 如果有微博/百度等账号，可以获取登录态来提高成功率：
#
# 方法 1: 使用 Playwright 自动导出
#   from playwright.sync_api import sync_playwright
#   with sync_playwright() as p:
#       browser = p.chromium.launch()
#       context = browser.new_context()
#       page = context.new_page()
#
#       # 访问网站并登录
#       page.goto("https://weibo.com/login")
#       # ... 手动操作浏览器进行登录 ...
#
#       # 导出状态
#       context.storage_state(path="storage_state.json")
#       context.close()
#       browser.close()
#
# 方法 2: 使用浏览器扩展导出
#   - 使用 Playwright Inspector 或 Puppeteer 扩展
#   - 登录后导出 cookies 和 local storage
#
# 然后：
#   1. 将 storage_state.json 放到服务器上
#   2. 在管理台上传，或直接放到 STORAGE_STATE_PATH
#   3. 重新执行任务
