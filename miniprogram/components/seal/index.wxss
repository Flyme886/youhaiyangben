/* 印章：外框粗、内框细，略微旋转；印泥不均匀用两层透明度模拟 */
.seal {
  --c: #b0362b;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  border: 6rpx solid var(--c);
  border-radius: 14rpx;
  color: var(--c);
  transform: rotate(-9deg);
  opacity: 0.9;
}

.seal-void {
  --c: #7a847f;
  opacity: 0.75;
}

.seal-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 16rpx;
  border: 2rpx solid var(--c);
  border-radius: 6rpx;
}

.seal-line {
  font-family: 'Songti SC', 'STSong', 'Noto Serif CJK SC', serif;
  font-weight: 900;
  line-height: 1.05;
  letter-spacing: 6rpx;
  text-indent: 6rpx;
}

.seal-sub {
  margin-top: 6rpx;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
}

/* 尺寸 */
.seal-md .seal-line {
  font-size: 38rpx;
}

.seal-md .seal-line-2 {
  font-size: 34rpx;
}

.seal-lg {
  border-width: 8rpx;
  border-radius: 18rpx;
  padding: 12rpx;
}

.seal-lg .seal-inner {
  padding: 14rpx 22rpx;
}

.seal-lg .seal-line {
  font-size: 56rpx;
}

.seal-lg .seal-line-2 {
  font-size: 52rpx;
}

/* 落章：从「悬在纸上方」压到纸面，带一点回弹 */
.seal-stamp {
  animation: seal-press 520ms cubic-bezier(0.2, 0.9, 0.3, 1.25) both;
}

@keyframes seal-press {
  0% {
    transform: rotate(-16deg) scale(1.9);
    opacity: 0;
  }
  55% {
    transform: rotate(-8deg) scale(0.94);
    opacity: 0.95;
  }
  100% {
    transform: rotate(-9deg) scale(1);
    opacity: 0.9;
  }
}

@media (prefers-reduced-motion: reduce) {
  .seal-stamp {
    animation: none;
  }
}
