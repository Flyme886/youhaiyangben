.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 48rpx 64rpx;
}

/* 档案夹：后片 + 一张纸 + 前片，前片略斜，像刚被翻开 */
.es-folder {
  position: relative;
  width: 200rpx;
  height: 150rpx;
  margin-bottom: 40rpx;
}

.es-tab {
  position: absolute;
  top: 0;
  left: 18rpx;
  width: 72rpx;
  height: 24rpx;
  border-radius: 10rpx 10rpx 0 0;
  background: #c9d0cc;
}

.es-back {
  position: absolute;
  top: 18rpx;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 12rpx;
  background: #c9d0cc;
}

.es-paper {
  position: absolute;
  top: 34rpx;
  left: 22rpx;
  right: 22rpx;
  height: 90rpx;
  border-radius: 6rpx;
  background: #ffffff;
  border: 1rpx solid #dde2df;
}

.es-front {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 92rpx;
  border-radius: 10rpx 10rpx 12rpx 12rpx;
  background: #dde2df;
  transform: perspective(300rpx) rotateX(14deg);
  transform-origin: bottom center;
}

.es-text {
  font-family: 'Songti SC', 'STSong', serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #18221e;
  text-align: center;
}

.es-hint {
  max-width: 540rpx;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #7a847f;
  text-align: center;
}

.es-btn {
  margin-top: 36rpx;
  padding: 0 44rpx;
}
