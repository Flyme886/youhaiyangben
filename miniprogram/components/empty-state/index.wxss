.es {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 56rpx 72rpx;
}

.es-stack {
  position: relative;
  width: 168rpx;
  height: 160rpx;
  margin-bottom: 44rpx;
}

.es-sheet {
  position: absolute;
  width: 132rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 2rpx #e4e6e2;
}

.es-sheet-3 {
  left: 36rpx;
  top: 0;
  transform: rotate(9deg);
  background: #eceeea;
}

.es-sheet-2 {
  left: 18rpx;
  top: 4rpx;
  transform: rotate(4deg);
  background: #f5f6f3;
}

.es-sheet-1 {
  left: 0;
  top: 10rpx;
  padding: 34rpx 22rpx;
}

.es-row {
  height: 10rpx;
  border-radius: 6rpx;
  background: #e4e6e2;
}

.es-row + .es-row {
  margin-top: 16rpx;
}

.es-row-short {
  width: 60%;
}

.es-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2329;
  text-align: center;
}

.es-hint {
  max-width: 540rpx;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #858c92;
  text-align: center;
}

.es-btn {
  margin-top: 40rpx;
  padding: 0 48rpx;
}
