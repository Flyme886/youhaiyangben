.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx 80rpx;
}

/* 纯 CSS 画的「文档叠页」插图，避免引入二进制图片资源 */
.art {
  position: relative;
  width: 180rpx;
  height: 200rpx;
  margin-bottom: 36rpx;
}

.sheet {
  position: absolute;
  left: 22rpx;
  top: 12rpx;
  width: 136rpx;
  height: 176rpx;
  background: #fffdf7;
  border: 2rpx solid #d8d2c6;
  border-radius: 12rpx;
}

.sheet-back {
  left: 6rpx;
  top: 0;
  width: 128rpx;
  height: 168rpx;
  background: #f1ede3;
  z-index: 0;
  transform: rotate(-6deg);
}

.sheet:not(.sheet-back) {
  z-index: 1;
}

.line {
  height: 10rpx;
  border-radius: 5rpx;
  background: #ded8cb;
  margin-left: 20rpx;
}

.line-1 {
  width: 96rpx;
  margin-top: 42rpx;
}

.line-2 {
  width: 72rpx;
  margin-top: 18rpx;
}

.line-3 {
  width: 84rpx;
  margin-top: 18rpx;
}

.art-plain .sheet {
  border-color: #e4dfd3;
}

.empty-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2522;
  text-align: center;
}

.empty-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #66736e;
  text-align: center;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 44rpx;
  height: 80rpx;
  padding: 0 56rpx;
  border-radius: 16rpx;
  background: #1d6f5f;
  border: 1rpx solid #114d42;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-btn-hover {
  opacity: 0.85;
}
