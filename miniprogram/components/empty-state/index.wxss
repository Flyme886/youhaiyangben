.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 88rpx 40rpx 72rpx;
}

/* 轻量文档插图，不使用厚重色块 */
.art {
  position: relative;
  width: 160rpx;
  height: 180rpx;
  margin-bottom: 32rpx;
}

.sheet {
  position: absolute;
  top: 12rpx;
  left: 20rpx;
  width: 124rpx;
  height: 160rpx;
  border: 2rpx solid #e5e5ea;
  border-radius: 16rpx;
  background: #ffffff;
}

.sheet-back {
  top: 0;
  left: 6rpx;
  width: 120rpx;
  height: 152rpx;
  background: #f5f5f7;
  transform: rotate(-6deg);
  z-index: 0;
}

.sheet:not(.sheet-back) {
  z-index: 1;
}

.line {
  height: 8rpx;
  margin-left: 20rpx;
  border-radius: 4rpx;
  background: #e5e5ea;
}

.line-1 {
  width: 80rpx;
  margin-top: 40rpx;
}

.line-2 {
  width: 62rpx;
  margin-top: 18rpx;
}

.line-3 {
  width: 72rpx;
  margin-top: 18rpx;
}

.art-plain .sheet {
  border-color: #eeeef2;
}

.empty-text {
  color: #1c1c1e;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.empty-hint {
  max-width: 520rpx;
  margin-top: 14rpx;
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.65;
  text-align: center;
}

.empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin-top: 36rpx;
  padding: 0 48rpx;
  border-radius: 18rpx;
  background: #1d6f5f;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-btn-hover {
  opacity: 0.75;
}
