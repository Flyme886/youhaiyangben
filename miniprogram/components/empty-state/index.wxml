<view class="es">
  <!-- 一叠表格：三张错开的纸，纯 CSS -->
  <view class="es-stack" aria-hidden="true">
    <view class="es-sheet es-sheet-3"></view>
    <view class="es-sheet es-sheet-2"></view>
    <view class="es-sheet es-sheet-1">
      <view class="es-row"></view>
      <view class="es-row"></view>
      <view class="es-row es-row-short"></view>
    </view>
  </view>

  <text class="es-text">{{text}}</text>
  <text wx:if="{{hint}}" class="es-hint">{{hint}}</text>

  <view
    wx:if="{{actionText}}"
    class="btn btn-soft btn-sm es-btn"
    hover-class="btn-press"
    bindtap="onAction"
  >{{actionText}}</view>
</view>
