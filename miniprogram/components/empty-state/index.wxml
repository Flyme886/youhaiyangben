<view class="es">
  <!-- 空档案夹：纯 CSS 绘制，无二进制资源 -->
  <view class="es-folder" aria-hidden="true">
    <view class="es-tab"></view>
    <view class="es-back"></view>
    <view class="es-paper"></view>
    <view class="es-front"></view>
  </view>

  <text class="es-text">{{text}}</text>
  <text wx:if="{{hint}}" class="es-hint">{{hint}}</text>

  <view
    wx:if="{{actionText}}"
    class="btn btn-primary btn-sm es-btn"
    hover-class="btn-press"
    bindtap="onAction"
  >{{actionText}}</view>
</view>
