.tag {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: 1rpx;
}

.tag-compact {
  height: 38rpx;
  padding: 0 12rpx;
  font-size: 21rpx;
}

.tag-text {
  line-height: 1;
}

.tag-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
  animation: tag-pulse 1.6s ease-in-out infinite;
}

@keyframes tag-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tag-dot {
    animation: none;
  }
}

.tag-info {
  background: #e8ece9;
  color: #4a5550;
}

.tag-active {
  background: #e3eee9;
  color: #1d5c4e;
}

.tag-ok {
  background: #e4f1e8;
  color: #2c7a4b;
}

.tag-warn {
  background: #f6ecdc;
  color: #9a5f12;
}

.tag-bad {
  background: #f6e4e1;
  color: #a83a30;
}

.tag-muted {
  background: #e8ece9;
  color: #7a847f;
}
