/* 状态：一个色点 + 文字。不用底色块，避免列表里满屏彩色胶囊 */
.st {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1;
  color: #4b535a;
}

.st-compact {
  font-size: 23rpx;
}

.st-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: currentColor;
}

.st-compact .st-dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 8rpx;
}

.st-dot-live {
  animation: st-pulse 1.6s ease-in-out infinite;
}

@keyframes st-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.25;
  }
}

@media (prefers-reduced-motion: reduce) {
  .st-dot-live {
    animation: none;
  }
}

.st-info {
  color: #858c92;
}

.st-active {
  color: #1f5a4c;
}

.st-ok {
  color: #2e7d5b;
}

.st-warn {
  color: #8e5e12;
}

.st-bad {
  color: #b4433a;
}

.st-muted {
  color: #858c92;
}
