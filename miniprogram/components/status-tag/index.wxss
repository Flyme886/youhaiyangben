.tag {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  border: 0;
  border-radius: 14rpx;
  background: #f5f5f7;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
}

.tag-compact {
  height: 38rpx;
  padding: 0 13rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.tag-text {
  line-height: 1;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 9rpx;
  border-radius: 50%;
  background: currentColor;
  animation: tag-pulse 1.5s ease-in-out infinite;
}

@keyframes tag-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

/* 排队中 */
.tag-info {
  background: #f5f5f7;
  color: #6e6e73;
}

/* 处理中 */
.tag-active {
  background: #edf6f3;
  color: #1d6f5f;
}

/* 已完成 */
.tag-ok {
  background: #f0f8f2;
  color: #248a3d;
}

/* 待处理 */
.tag-warn {
  background: #fff7e8;
  color: #9a5b13;
}

/* 失败 */
.tag-bad {
  background: #fff1f1;
  color: #c43c3c;
}

/* 已取消 / 未知 */
.tag-muted {
  background: #f5f5f7;
  color: #8e8e93;
}
