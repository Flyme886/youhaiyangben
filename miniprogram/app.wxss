/**
 * 全局样式 —— 沿用 Web 后台的「暖纸 + 墨绿」品牌色
 * 设计稿基准宽度 750rpx，所有尺寸用 rpx
 */
page {
  /* 品牌色板（与 app/static/style.css 保持一致） */
  --paper: #f7f4ee;
  --ink: #1d2522;
  --muted: #66736e;
  --line: #d8d2c6;
  --panel: #fffdf7;
  --accent: #1d6f5f;
  --accent-strong: #114d42;
  --warn: #9b4a20;
  --bad: #9a2f2f;
  --ok: #256a43;

  --radius: 16rpx;
  --radius-lg: 24rpx;
  --gap: 24rpx;

  background-color: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page-wrap {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
}

.row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.safe-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--panel);
  border: 1rpx solid var(--line);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-tight {
  padding: 22rpx 24rpx;
}

.card-title {
  /* <text> 默认是 inline，两个相邻的 <text> 会挤在同一行，
     必须显式 block 才能让标题和副标题各占一行。
     （登录页没这个毛病是因为父容器是 flex column，会隐式块级化。） */
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 6rpx;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}

/* ---------- 文本 ---------- */
.muted {
  color: var(--muted);
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.strong {
  font-weight: 600;
}

.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 600;
  border: 1rpx solid transparent;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent-strong);
}

.btn-primary[disabled] {
  background: #a9bdb7;
  border-color: #a9bdb7;
  color: #f2f5f4;
}

.btn-ghost {
  background: transparent;
  color: var(--accent-strong);
  border-color: var(--accent);
}

.btn-muted {
  background: transparent;
  color: var(--muted);
  border-color: var(--line);
}

.btn-danger {
  background: transparent;
  color: var(--bad);
  border-color: var(--bad);
}

.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/**
 * 注意：原生 <input> 不会因为 padding 自动撑高，必须给显式 height + line-height，
 * 否则文字会被上下裁掉（placeholder 只露一半）。textarea 相反，用 min-height。
 */
.field-input {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 0 22rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  box-sizing: border-box;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--ink);
}

.field-hint {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------- 通用状态 ---------- */
.loading-line {
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  padding: 28rpx 0;
}

.error-text {
  color: var(--bad);
  font-weight: 600;
}

.skeleton {
  background: linear-gradient(90deg, #ece7dd 25%, #f4f0e8 37%, #ece7dd 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 8rpx;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
