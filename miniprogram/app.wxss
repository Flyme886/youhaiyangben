/**
 * 舆见 · 样本任务台 —— 全局视觉规范
 *
 * 隐喻：证据册 / 卷宗。纸面是冷灰绿的档案纸，正文是墨，主色墨绿；
 * 朱砂只留给「交付印章」这一处，别处一律不用，保证它出现时有分量。
 *
 * 基准宽度 750rpx，所有尺寸用 rpx。
 */
page {
  /* 纸与墨 */
  --paper: #f1f3f1;
  --sheet: #ffffff;
  --ink: #18221e;
  --ink-2: #4a5550;
  --muted: #7a847f;
  --rule: #dde2df;
  --rule-strong: #c9d0cc;
  --well: #e8ece9;

  /* 墨绿：品牌与主操作 */
  --accent: #1d5c4e;
  --accent-press: #154538;
  --accent-wash: #e3eee9;

  /* 语义色 */
  --ok: #2c7a4b;
  --ok-wash: #e4f1e8;
  --warn: #9a5f12;
  --warn-wash: #f6ecdc;
  --bad: #a83a30;
  --bad-wash: #f6e4e1;

  /* 朱砂：仅用于印章 */
  --seal: #b0362b;

  --serif: 'Songti SC', 'STSong', 'Noto Serif CJK SC', 'Source Han Serif SC', serif;
  --sans: -apple-system, 'PingFang SC', 'HarmonyOS Sans SC', 'MiSans', 'Microsoft YaHei', sans-serif;

  background-color: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-size: 28rpx;
  line-height: 1.55;
  font-variant-numeric: tabular-nums;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

button::after {
  border: none;
}

/* ---------- 版面 ---------- */

.page {
  min-height: 100vh;
  padding: 8rpx 32rpx 64rpx;
}

/* 底部有固定操作栏的页面，给内容留出空间 */
.page-with-bar {
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.masthead {
  padding: 28rpx 0 32rpx;
}

.masthead-title {
  display: block;
  font-family: var(--serif);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: var(--ink);
}

.masthead-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--muted);
}

/* 纸页：内容的承载面。圆角克制，用一条细描边而不是阴影 */
.sheet {
  background: var(--sheet);
  border: 1rpx solid var(--rule);
  border-radius: 20rpx;
  padding: 32rpx;
}

.sheet + .sheet,
.sheet + .section,
.section + .sheet,
.section + .section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 40rpx 4rpx 16rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.section-aside {
  font-size: 24rpx;
  color: var(--muted);
}

.row {
  display: flex;
  align-items: center;
}

.grow {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.muted {
  color: var(--muted);
}

.small {
  font-size: 24rpx;
}

/* ---------- 按钮 ---------- */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  margin: 0;
  padding: 0 36rpx;
  border: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  background: var(--well);
  color: var(--ink);
}

/* 原生 <button> 在 style v2 下有固定宽度和外边距，这里统一抹掉 */
button.btn {
  width: auto;
  min-width: 0;
  margin: 0;
}

.btn-primary {
  background: var(--accent);
  color: #ffffff;
}

.btn-primary.btn-press {
  background: var(--accent-press);
}

.btn-primary[disabled] {
  background: var(--rule-strong) !important;
  color: #ffffff !important;
}

.btn-quiet {
  background: var(--accent-wash);
  color: var(--accent);
}

.btn-danger {
  background: transparent;
  color: var(--bad);
  border: 1rpx solid var(--rule-strong);
}

.btn-sm {
  height: 68rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  border-radius: 14rpx;
}

.btn-press {
  opacity: 0.72;
}

/* ---------- 固定底栏 ---------- */

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(241, 243, 241, 0.94);
  border-top: 1rpx solid var(--rule);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.action-bar .btn {
  flex: 1;
}

/* ---------- 表单 ---------- */

.field + .field {
  margin-top: 28rpx;
}

.field-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.field-input,
.field-textarea {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid var(--rule);
  border-radius: 14rpx;
  background: var(--paper);
  color: var(--ink);
  font-size: 29rpx;
}

.field-input {
  height: 92rpx;
}

.field-textarea {
  height: 160rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  line-height: 1.6;
}

.placeholder {
  color: #a6aea9;
}

/* ---------- 进度条 ---------- */

.track {
  position: relative;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--well);
  overflow: hidden;
}

.track-fill {
  height: 100%;
  border-radius: 8rpx;
  background: var(--accent);
  transition: width 0.5s ease;
}

/* ---------- 提示条 ---------- */

.notice {
  padding: 22rpx 26rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.notice-bad {
  background: var(--bad-wash);
  color: var(--bad);
}

.notice-warn {
  background: var(--warn-wash);
  color: var(--warn);
}

.notice-detail {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-2);
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- 骨架 ---------- */

.skeleton {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #e6eae7 25%, #eff2f0 37%, #e6eae7 63%);
  background-size: 400% 100%;
  animation: skeleton 1.4s ease infinite;
}

@keyframes skeleton {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton {
    animation: none;
  }
  .track-fill {
    transition: none;
  }
}
