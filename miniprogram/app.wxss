/**
 * 全局视觉规范：纯白底、iPhone 式层级、墨绿品牌强调
 * 设计稿基准宽度 750rpx，所有尺寸使用 rpx
 */
page {
  --paper: #ffffff;
  --panel: #ffffff;
  --ink: #1c1c1e;
  --muted: #6e6e73;
  --subtle: #8e8e93;
  --line: #e5e5ea;
  --fill: #f5f5f7;
  --fill-strong: #ececf0;
  --accent: #1d6f5f;
  --accent-strong: #125145;
  --accent-soft: #edf6f3;
  --warn: #9a5b13;
  --warn-soft: #fff7e8;
  --bad: #c43c3c;
  --bad-soft: #fff1f1;
  --ok: #248a3d;

  --radius: 18rpx;
  --radius-lg: 24rpx;
  --gap: 24rpx;

  background-color: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue',
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
image,
scroll-view {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page-wrap {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: var(--paper);
}

.page-heading {
  padding: 20rpx 0 36rpx;
}

.page-title {
  display: block;
  color: var(--ink);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.page-subtitle {
  display: block;
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 25rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.safe-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* ---------- 内容分区：默认不使用浮层卡片 ---------- */
.card {
  padding: 32rpx 0;
  margin: 0;
  background: var(--panel);
  border-bottom: 1rpx solid var(--line);
}

.card-tight {
  padding: 24rpx 0;
}

.card-title {
  display: block;
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.card-sub {
  display: block;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

/* ---------- 文本 ---------- */
.muted {
  color: var(--muted);
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.strong {
  font-weight: 600;
}

.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-variant-numeric: tabular-nums;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  padding: 0 32rpx;
  border: 0;
  border-radius: var(--radius);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  color: #ffffff;
}

.btn-primary[disabled] {
  background: var(--fill-strong);
  color: #aeaeb2;
}

.btn-ghost {
  background: var(--accent-soft);
  color: var(--accent);
}

.btn-muted {
  background: var(--fill);
  color: var(--muted);
}

.btn-danger {
  background: var(--fill);
  color: var(--bad);
}

.btn-sm {
  height: 72rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 30rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 500;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: var(--fill);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 96rpx;
  box-sizing: border-box;
}

.field-textarea {
  width: 100%;
  min-height: 152rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: var(--fill);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.field-hint {
  display: block;
  margin-top: 10rpx;
  color: var(--subtle);
  font-size: 22rpx;
  text-align: right;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: var(--line);
}

/* ---------- 通用状态 ---------- */
.loading-line {
  padding: 28rpx 0;
  color: var(--muted);
  font-size: 24rpx;
  text-align: center;
}

.error-text {
  color: var(--bad);
  font-weight: 500;
}

.card-hover {
  opacity: 0.55;
}

.skeleton {
  border-radius: 8rpx;
  background: linear-gradient(90deg, #f0f0f2 25%, #f8f8fa 37%, #f0f0f2 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
