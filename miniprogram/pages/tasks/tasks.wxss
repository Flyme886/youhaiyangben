/* ---------- 自定义导航 ---------- */

.nav {
  box-sizing: border-box;
}

.nav-row {
  gap: 20rpx;
}

/* 设置入口：一个线描人像，圆形描边 */
.nav-me {
  position: relative;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: inset 0 0 0 2rpx var(--line);
  overflow: hidden;
}

.nav-me-head {
  position: absolute;
  top: 14rpx;
  left: 24rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid var(--ink-2);
}

.nav-me-body {
  position: absolute;
  top: 36rpx;
  left: 17rpx;
  width: 30rpx;
  height: 20rpx;
  border-radius: 16rpx 16rpx 0 0;
  border: 3rpx solid var(--ink-2);
  border-bottom: 0;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

/* ---------- 开场 ---------- */

.intro {
  padding: 44rpx 8rpx 40rpx;
}

/* ---------- 进行中 ---------- */

.live-card {
  padding: 36rpx 32rpx 32rpx;
}

.live-card + .live-card {
  margin-top: 20rpx;
}

.live-name {
  margin-right: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.live-step {
  margin: 28rpx 0 16rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: var(--primary);
}

.live-step-no {
  font-size: 24rpx;
  color: var(--muted);
}

.live-meta {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* ---------- 筛选 + 搜索 ---------- */

.tools {
  margin-top: 40rpx;
  gap: 16rpx;
}

.chips-scroll {
  white-space: nowrap;
}

.chips {
  display: inline-flex;
  gap: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--surface);
  font-size: 26rpx;
  color: var(--ink-2);
}

.chip-n {
  margin-left: 10rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--muted);
}

.chip-n-bad {
  color: var(--bad);
}

.chip-on {
  background: var(--ink);
  color: #ffffff;
  font-weight: 600;
}

.chip-on .chip-n {
  color: rgba(255, 255, 255, 0.7);
}

.search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface);
}

.search-btn-on {
  background: var(--primary-wash);
}

/* 放大镜：圆 + 柄 */
.glass {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin: -4rpx 0 0 -4rpx;
  border: 3rpx solid var(--ink-2);
  border-radius: 50%;
}

.glass::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--ink-2);
  transform: rotate(45deg);
}

.search {
  margin-top: 20rpx;
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--surface);
}

.search-input {
  height: 88rpx;
  font-size: 29rpx;
}

.search-cancel {
  padding-left: 24rpx;
  font-size: 26rpx;
  color: var(--primary);
}

/* ---------- 任务行 ---------- */

.task {
  gap: 24rpx;
}

.task-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.task-meta {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
  overflow: hidden;
}

.task-meta-warn {
  flex-shrink: 0;
  color: var(--blocked-ink);
}

.task-note {
  flex: 1;
  min-width: 0;
  color: var(--ink-2);
}

.list-end {
  padding: 40rpx 0 0;
  font-size: 23rpx;
  color: var(--faint);
  text-align: center;
}

/* ---------- 底栏按钮里的加号 ---------- */

.plus {
  position: relative;
  width: 24rpx;
  height: 24rpx;
  margin-right: 14rpx;
}

.plus::before,
.plus::after {
  content: '';
  position: absolute;
  border-radius: 2rpx;
  background: #ffffff;
}

.plus::before {
  left: 0;
  right: 0;
  top: 10rpx;
  height: 4rpx;
}

.plus::after {
  top: 0;
  bottom: 0;
  left: 10rpx;
  width: 4rpx;
}

/* ---------- 状态 ---------- */

.sk-panel {
  padding: 4rpx 0;
}

.sk-row {
  padding: 32rpx;
}

.sk-row + .sk-row {
  border-top: 1rpx solid var(--line);
}

.sk-title {
  width: 58%;
  height: 32rpx;
}

.sk-meta {
  width: 32%;
  height: 22rpx;
  margin-top: 16rpx;
}

.load-error {
  margin-top: 8rpx;
}

.retry {
  width: 220rpx;
  margin-top: 20rpx;
}
