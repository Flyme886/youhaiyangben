/* ---------------- 概览 ---------------- */
.stats {
  display: flex;
  margin-bottom: 28rpx;
  padding: 0 0 28rpx;
  border-bottom: 1rpx solid #e5e5ea;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.stat-value {
  color: #1c1c1e;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  transition: color 0.18s ease;
}

.stat-on .stat-value,
.stat-on .stat-label {
  color: #1d6f5f;
}

.stat-label {
  margin-top: 10rpx;
  color: #6e6e73;
  font-size: 22rpx;
}

/* 状态色仅在非选中状态承担语义提示 */
.stat-active {
  color: #1d6f5f;
}

.stat-ok {
  color: #1c1c1e;
}

.stat-bad {
  color: #c43c3c;
}

.stat-muted {
  color: #8e8e93;
}

/* ---------------- iPhone 式分段筛选 ---------------- */
.tabs {
  display: flex;
  gap: 4rpx;
  margin-bottom: 12rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
}

.tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 13rpx;
  color: #6e6e73;
  font-size: 25rpx;
  transition: color 0.18s ease, background 0.18s ease;
}

.tab-on {
  background: #ffffff;
  color: #1c1c1e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.07);
}

/* ---------------- 连续任务列表 ---------------- */
.task-card {
  position: relative;
  padding: 30rpx 0;
}

.task-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.task-name {
  flex: 1;
  color: #1c1c1e;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.4;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.task-note {
  display: block;
  margin-top: 10rpx;
}

.progress {
  height: 6rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 3rpx;
  background: #ececf0;
}

.progress-bar {
  height: 100%;
  border-radius: 3rpx;
  background: #1d6f5f;
  transition: width 0.25s ease;
}

.task-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.foot-chips {
  display: flex;
  gap: 18rpx;
  flex-shrink: 0;
}

.chip {
  padding: 0;
  border: 0;
  background: transparent;
  color: #6e6e73;
  font-size: 22rpx;
  line-height: 1.4;
}

.chip-ok {
  color: #1c1c1e;
}

.chip-warn {
  color: #9a5b13;
}

/* ---------------- 骨架 / 错误 ---------------- */
.sk-title {
  width: 55%;
  height: 34rpx;
  margin-bottom: 18rpx;
}

.sk-sub {
  width: 35%;
  height: 22rpx;
  margin-bottom: 22rpx;
}

.sk-bar {
  width: 100%;
  height: 6rpx;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-top: 24rpx;
  padding: 36rpx 28rpx;
  border: 0;
  border-radius: 20rpx;
  background: #fff1f1;
}

.retry-btn {
  padding: 0 40rpx;
}

/* 失败详情完整可见，便于真机排查 */
.error-detail {
  display: block;
  width: 100%;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6e6e73;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: left;
  white-space: pre-wrap;
  word-break: break-all;
}

.load-more {
  padding: 30rpx 0 16rpx;
  text-align: center;
}
