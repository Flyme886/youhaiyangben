/* ---------- 搜索 ---------- */

.search {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--rule);
  border-radius: 16rpx;
  background: var(--sheet);
}

.search-on {
  border-color: var(--accent);
}

/* 放大镜：一个圆 + 一根柄 */
.search-glass {
  position: relative;
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
  margin-right: 16rpx;
  border: 3rpx solid var(--muted);
  border-radius: 50%;
}

.search-glass::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -7rpx;
  width: 10rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: var(--muted);
  transform: rotate(45deg);
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.search-clear {
  padding: 0 0 0 20rpx;
  font-size: 25rpx;
  color: var(--accent);
}

/* ---------- 筛选 ---------- */

.filters {
  display: flex;
  gap: 40rpx;
  margin: 28rpx 4rpx 8rpx;
  border-bottom: 1rpx solid var(--rule);
}

.filter {
  position: relative;
  display: flex;
  align-items: baseline;
  padding: 16rpx 0 20rpx;
  color: var(--muted);
}

.filter-label {
  font-size: 28rpx;
}

.filter-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.filter-count-bad {
  color: var(--bad);
}

.filter-on {
  color: var(--ink);
}

.filter-on .filter-label {
  font-weight: 600;
}

.filter-on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1rpx;
  height: 5rpx;
  border-radius: 4rpx;
  background: var(--accent);
}

/* ---------- 进行中 ---------- */

.live-card {
  padding: 30rpx 32rpx 26rpx;
  border-color: var(--accent);
  border-width: 2rpx;
}

.live-card + .live-card {
  margin-top: 20rpx;
}

.live-head {
  gap: 16rpx;
}

.task-name {
  font-family: var(--serif);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.live-step {
  margin: 22rpx 0 14rpx;
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 500;
}

.live-step-no {
  font-size: 24rpx;
  color: var(--muted);
}

.live-meta {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.sheet-press {
  background: #f7f9f8;
}

/* ---------- 已结束：目录 ---------- */

.list-sheet {
  padding: 0;
  overflow: hidden;
}

.list-sheet-first {
  margin-top: 24rpx;
}

.task-row {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 32rpx 28rpx 0;
}

.task-row + .task-row {
  border-top: 1rpx solid var(--rule);
}

.task-row-press {
  background: #f7f9f8;
}

.task-row .task-name {
  font-size: 30rpx;
  margin-right: 16rpx;
}

/* 书脊：状态色，一眼扫出哪几本有问题 */
.spine {
  flex-shrink: 0;
  width: 6rpx;
  margin: 4rpx 0;
  border-radius: 0 4rpx 4rpx 0;
  background: var(--rule-strong);
}

.spine-ok {
  background: var(--ok);
}

.spine-bad {
  background: var(--bad);
}

.spine-warn {
  background: var(--warn);
}

.row-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.meta-warn {
  color: var(--warn);
}

.row-note {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--ink-2);
}

/* ---------- 状态 ---------- */

.sk-row {
  padding: 30rpx 32rpx;
}

.sk-row + .sk-row {
  border-top: 1rpx solid var(--rule);
}

.sk-title {
  width: 56%;
  height: 32rpx;
}

.sk-meta {
  width: 34%;
  height: 22rpx;
  margin-top: 16rpx;
}

.load-error {
  margin-top: 24rpx;
}

.retry {
  margin-top: 20rpx;
  width: 220rpx;
}

.load-more {
  padding: 36rpx 0 8rpx;
  font-size: 23rpx;
  color: var(--muted);
  text-align: center;
}
