<view class="page">
  <view class="masthead">
    <text class="masthead-title">任务</text>
    <text class="masthead-sub">{{headline}}</text>
  </view>

  <!-- 搜索：后端 /tasks/mine 支持按任务名 / 编号模糊查 -->
  <view class="search {{keyword ? 'search-on' : ''}}">
    <view class="search-glass" aria-hidden="true"></view>
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索任务名或编号"
      placeholder-class="placeholder"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="onKeywordConfirm"
    />
    <view wx:if="{{keyword}}" class="search-clear" bindtap="onKeywordClear" aria-label="清除搜索">清除</view>
  </view>

  <!-- 筛选：数字直接长在标签上，不再单独摆一排统计卡 -->
  <view class="filters" aria-role="tablist">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="filter {{activeFilter === item.key ? 'filter-on' : ''}}"
      aria-role="tab"
      aria-selected="{{activeFilter === item.key}}"
      bindtap="onFilterTap"
      data-key="{{item.key}}"
    >
      <text class="filter-label">{{item.label}}</text>
      <text wx:if="{{item.count !== null}}" class="filter-count {{item.key === 'issue' && item.count > 0 ? 'filter-count-bad' : ''}}">{{item.count}}</text>
    </view>
  </view>

  <!-- 首屏骨架 -->
  <view wx:if="{{firstLoading}}" class="sheet list-sheet">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="sk-row">
      <view class="skeleton sk-title"></view>
      <view class="skeleton sk-meta"></view>
    </view>
  </view>

  <!-- 加载失败：把原因和定位信息一起摊开 -->
  <view wx:elif="{{error}}" class="notice notice-bad load-error">
    <text>{{error}}</text>
    <text wx:if="{{errorDetail}}" class="notice-detail">{{errorDetail}}</text>
    <view class="btn btn-sm btn-quiet retry" hover-class="btn-press" bindtap="onRetry">重新加载</view>
  </view>

  <!-- 空状态 -->
  <block wx:elif="{{liveList.length === 0 && restList.length === 0}}">
    <empty-state
      wx:if="{{keyword}}"
      text="没有匹配的任务"
      hint="换个关键词，或清除搜索查看全部任务"
    />
    <empty-state
      wx:elif="{{activeFilter !== 'all'}}"
      text="这里暂时是空的"
      hint="切到「全部」看看其它任务"
    />
    <empty-state
      wx:else
      text="还没有任务"
      hint="上传一份含链接的 Excel，服务器会逐条截图，每 50 条装订成一册 Word"
      actionText="上传表格"
      bind:action="onGoNew"
    />
  </block>

  <block wx:else>
    <!-- 进行中：置顶、展开显示步骤和进度 -->
    <block wx:if="{{liveList.length > 0}}">
      <view class="section-head">
        <text class="section-title">正在处理</text>
        <text class="section-aside">每 5 秒自动刷新</text>
      </view>

      <view
        wx:for="{{liveList}}"
        wx:key="id"
        class="sheet live-card"
        hover-class="sheet-press"
        hover-stay-time="60"
        bindtap="onTaskTap"
        data-id="{{item.id}}"
      >
        <view class="row live-head">
          <text class="task-name grow ellipsis">{{item.nameText}}</text>
          <status-tag status="{{item.status}}" compact="{{true}}" />
        </view>

        <view class="row live-step">
          <text class="grow">{{item.stepText}}</text>
          <text class="live-step-no">{{item.stepNo}}/4</text>
        </view>

        <view class="track">
          <view class="track-fill" style="width: {{item.progress}}%"></view>
        </view>

        <text class="live-meta">{{item.status === 'queued' ? '提交于 ' + item.createdText : '已运行 ' + item.durationText}}</text>
      </view>
    </block>

    <!-- 已结束：一张纸上的目录，左侧色条当书脊 -->
    <block wx:if="{{restList.length > 0}}">
      <view wx:if="{{liveList.length > 0}}" class="section-head">
        <text class="section-title">已结束</text>
      </view>
      <view class="sheet list-sheet {{liveList.length > 0 ? '' : 'list-sheet-first'}}">
        <view
          wx:for="{{restList}}"
          wx:key="id"
          class="task-row"
          hover-class="task-row-press"
          hover-stay-time="60"
          bindtap="onTaskTap"
          data-id="{{item.id}}"
        >
          <view class="spine spine-{{item.statusTone}}" aria-hidden="true"></view>
          <view class="grow">
            <view class="row">
              <text class="task-name grow ellipsis">{{item.nameText}}</text>
              <status-tag status="{{item.status}}" compact="{{true}}" />
            </view>
            <view class="row-meta">
              <text>{{item.createdText}}</text>
              <text wx:if="{{item.docx_count > 0}}">Word {{item.docx_count}} 册</text>
              <text wx:if="{{item.issue_count > 0}}" class="meta-warn">缺图 {{item.issue_count}} 条</text>
            </view>
            <text wx:if="{{item.note}}" class="row-note ellipsis">{{item.note}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="load-more">
      <text wx:if="{{loading && !firstLoading}}">加载中</text>
      <text wx:elif="{{!hasMore && total > 0}}">共 {{total}} 个任务</text>
    </view>
  </block>
</view>
