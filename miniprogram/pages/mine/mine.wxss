/* ---------------- 账号 ---------------- */
.account {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding-top: 0;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #edf6f3;
  color: #1d6f5f;
  font-size: 36rpx;
  font-weight: 600;
}

.account-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-title {
  color: #1c1c1e;
  font-size: 31rpx;
  font-weight: 600;
}

.health {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 9rpx;
  padding: 12rpx 0 12rpx 12rpx;
  color: #6e6e73;
}

.health-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #aeaeb2;
}

.health-ok {
  color: #248a3d;
}

.health-ok .health-dot {
  background: #248a3d;
}

.health-bad {
  color: #c43c3c;
}

.health-bad .health-dot {
  background: #c43c3c;
}

.health-pending .health-dot {
  background: #c7a15a;
  animation: health-blink 1.4s ease-in-out infinite;
}

@keyframes health-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

/* ---------------- 统计 ---------------- */
.stat-grid {
  display: flex;
  margin-top: 26rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.stat-value {
  color: #1c1c1e;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

/* ---------------- FAQ ---------------- */
.faq-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeef2;
}

.faq-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.faq-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.faq-q {
  flex: 1;
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 1.5;
}

.faq-open .faq-q {
  color: #1d6f5f;
  font-weight: 600;
}

.faq-sign {
  flex-shrink: 0;
  width: 32rpx;
  color: #8e8e93;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
}

.faq-a {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 25rpx;
  line-height: 1.7;
}

/* ---------------- 环境信息 ---------------- */
.environment-card {
  border-bottom: 0;
}

.details {
  margin-top: 20rpx;
  padding: 8rpx 22rpx;
  border-radius: 16rpx;
  background: #f5f5f7;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-value {
  max-width: 420rpx;
  text-align: right;
}

/* ---------------- 退出 ---------------- */
.logout {
  width: 100%;
  margin-top: 30rpx;
}

.footer {
  display: block;
  margin-top: 40rpx;
  text-align: center;
}
