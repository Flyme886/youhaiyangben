/* ---------- 账号 ---------- */

.account {
  padding-bottom: 0;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-right: 24rpx;
  border: 4rpx solid var(--accent);
  border-radius: 14rpx;
  color: var(--accent);
  font-family: var(--serif);
  font-size: 44rpx;
  font-weight: 900;
}

.account-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.account-id {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.health {
  margin: 28rpx -32rpx 0;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--rule);
  font-size: 25rpx;
  color: var(--ink-2);
}

.health-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: var(--rule-strong);
}

.health-ok .health-dot {
  background: var(--ok);
}

.health-bad {
  color: var(--bad);
}

.health-bad .health-dot {
  background: var(--bad);
}

.health-retry {
  color: var(--accent);
}

/* ---------- 统计 ---------- */

.stats {
  display: flex;
  padding: 8rpx 0;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
}

.stat + .stat {
  border-left: 1rpx solid var(--rule);
  border-radius: 0;
}

.stat-press {
  background: #f7f9f8;
}

.stat-value {
  font-family: var(--serif);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
}

.stat-bad {
  color: var(--bad);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
}

/* ---------- 常见问题 ---------- */

.faq {
  padding: 0 32rpx;
}

.faq-item + .faq-item {
  border-top: 1rpx solid var(--rule);
}

.faq-q {
  padding: 28rpx 0;
  font-size: 27rpx;
  color: var(--ink);
}

.faq-chevron {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-left: 20rpx;
  border-right: 3rpx solid var(--muted);
  border-bottom: 3rpx solid var(--muted);
  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

.faq-open .faq-chevron {
  transform: rotate(-135deg);
}

.faq-open .faq-q {
  font-weight: 600;
}

.faq-a {
  display: block;
  padding-bottom: 28rpx;
  font-size: 25rpx;
  line-height: 1.75;
  color: var(--ink-2);
}

/* ---------- 环境 ---------- */

.env {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.env-head {
  padding: 28rpx 0;
}

.env-title {
  font-size: 27rpx;
  color: var(--ink-2);
}

.env-sign {
  font-size: 24rpx;
  color: var(--accent);
}

.env-body {
  padding-bottom: 24rpx;
}

.kv {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--ink-2);
}

.kv-key {
  flex-shrink: 0;
  margin-right: 24rpx;
}

.kv-link {
  color: var(--accent);
  text-align: right;
}

.logout {
  margin-top: 48rpx;
}

.footer {
  display: block;
  margin-top: 32rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: center;
}

@media (prefers-reduced-motion: reduce) {
  .faq-chevron {
    transition: none;
  }
}
