/* ---------------- 账号 ---------------- */
.account {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #1d6f5f;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.account-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.account-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1d2522;
}

.health {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid #d8d2c6;
  background: #f4f1e9;
  flex-shrink: 0;
}

.health-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #b4b2a9;
}

.health-ok {
  border-color: #a8c9b4;
  background: #eaf3ec;
}

.health-ok .health-dot {
  background: #256a43;
}

.health-bad {
  border-color: #dda8a8;
  background: #fbeaea;
}

.health-bad .health-dot {
  background: #9a2f2f;
}

.health-pending .health-dot {
  background: #d0a15c;
  animation: health-blink 1s ease-in-out infinite;
}

@keyframes health-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}

/* ---------------- 统计 ---------------- */
.stat-grid {
  display: flex;
  margin-top: 22rpx;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-cell:not(:last-child) {
  border-right: 1rpx solid #ece7dd;
}

.stat-value {
  font-size: 42rpx;
  font-weight: 600;
  color: #1d2522;
  line-height: 1.1;
}

/* ---------------- FAQ ---------------- */
.faq-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ece7dd;
}

.faq-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.faq-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.faq-q {
  flex: 1;
  font-size: 27rpx;
  color: #1d2522;
  line-height: 1.5;
}

.faq-open .faq-q {
  font-weight: 600;
  color: #114d42;
}

.faq-sign {
  font-size: 32rpx;
  color: #66736e;
  line-height: 1.2;
  flex-shrink: 0;
  width: 32rpx;
  text-align: center;
}

.faq-a {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #66736e;
  line-height: 1.7;
}

/* ---------------- 环境信息 ---------------- */
.details {
  margin-top: 22rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ece7dd;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-value {
  max-width: 420rpx;
  text-align: right;
}

/* ---------------- 退出 ---------------- */
.logout {
  width: 100%;
  margin-top: 12rpx;
}

.footer {
  display: block;
  text-align: center;
  margin-top: 44rpx;
}
