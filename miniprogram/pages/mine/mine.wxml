<view class="page">
  <view class="intro">
    <text class="title-xl">设置与帮助</text>
  </view>

  <!-- 账号 + 服务器状态 -->
  <view class="panel">
    <view class="line-row">
      <view class="avatar" aria-hidden="true">
        <view class="avatar-head"></view>
        <view class="avatar-body"></view>
      </view>
      <view class="grow">
        <text class="who">{{isAdmin ? '管理员' : '业务账号'}}</text>
        <text class="who-id">{{openidMasked}}</text>
      </view>
    </view>
    <view class="line-row health health-{{health === null ? 'pending' : (health ? 'ok' : 'bad')}}" bindtap="checkHealth">
      <view class="health-dot"></view>
      <text class="grow">{{healthText}}</text>
      <text wx:if="{{health === false}}" class="health-retry">重新检测</text>
    </view>
  </view>

  <!-- 我的任务：点数字回首页并切到对应筛选 -->
  <view class="group-head">
    <text class="group-title">我的任务</text>
    <text class="group-aside">点数字查看</text>
  </view>
  <view class="panel stats">
    <view
      wx:for="{{statCards}}"
      wx:key="key"
      class="stat"
      hover-class="row-press"
      bindtap="onStatTap"
      data-key="{{item.key}}"
    >
      <text class="stat-n {{item.key === 'issue' && item.value > 0 ? 'stat-bad' : ''}}">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 常见问题 -->
  <view class="group-head">
    <text class="group-title">常见问题</text>
  </view>
  <view class="panel">
    <view
      wx:for="{{faq}}"
      wx:key="q"
      class="faq"
      bindtap="onFaqTap"
      data-index="{{index}}"
    >
      <view class="fold-head">
        <text class="fold-title {{faqOpenIndex === index ? 'faq-on' : ''}}">{{item.q}}</text>
        <view class="chevron {{faqOpenIndex === index ? 'chevron-open' : ''}}"></view>
      </view>
      <text wx:if="{{faqOpenIndex === index}}" class="faq-a">{{item.a}}</text>
    </view>
  </view>

  <!-- 环境信息：排查问题时才看 -->
  <view class="panel env">
    <view class="fold-head" bindtap="toggleDetails">
      <text class="fold-title">环境信息</text>
      <view class="chevron {{detailsOpen ? 'chevron-open' : ''}}"></view>
    </view>
    <view wx:if="{{detailsOpen}}" class="fold-body">
      <view class="kv">
        <text class="kv-key">运行环境</text>
        <text class="kv-val">{{envLabel}}</text>
      </view>
      <view class="kv">
        <text class="kv-key">运行版本</text>
        <text class="kv-val">{{envVersion}}</text>
      </view>
      <view class="kv" bindtap="onCopyBaseUrl">
        <text class="kv-key">服务地址</text>
        <text class="kv-val kv-link ellipsis">{{baseUrl}}</text>
      </view>
      <view class="kv">
        <text class="kv-key">服务器时间</text>
        <text class="kv-val">{{serverTime || '未取到'}}</text>
      </view>
      <view class="kv">
        <text class="kv-key">客户端版本</text>
        <text class="kv-val">{{version}}</text>
      </view>
    </view>
  </view>

  <view class="btn btn-danger logout" hover-class="btn-press" bindtap="onLogout">退出登录</view>
</view>
