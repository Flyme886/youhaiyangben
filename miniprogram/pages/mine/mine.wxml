<view class="page-wrap">
  <!-- 账号 -->
  <view class="card account">
    <view class="avatar">样</view>
    <view class="flex-1 account-info">
      <text class="account-title">业务账号</text>
      <text class="tiny muted mono">{{openidMasked}}</text>
    </view>
    <view class="health health-{{health === null ? 'pending' : (health ? 'ok' : 'bad')}}">
      <view class="health-dot"></view>
      <text class="tiny">{{healthText}}</text>
    </view>
  </view>

  <!-- 我的数据 -->
  <view class="card">
    <text class="card-title">我的任务</text>
    <view class="stat-grid">
      <view wx:for="{{statCards}}" wx:key="label" class="stat-cell">
        <text class="stat-value">{{item.value}}</text>
        <text class="tiny muted">{{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- 常见问题 -->
  <view class="card">
    <text class="card-title">常见问题</text>
    <view
      wx:for="{{faq}}"
      wx:key="q"
      class="faq-item {{faqOpenIndex === index ? 'faq-open' : ''}}"
      bindtap="onFaqTap"
      data-index="{{index}}"
    >
      <view class="faq-head">
        <text class="faq-q">{{item.q}}</text>
        <text class="faq-sign">{{faqOpenIndex === index ? '−' : '+'}}</text>
      </view>
      <text wx:if="{{faqOpenIndex === index}}" class="faq-a">{{item.a}}</text>
    </view>
  </view>

  <!-- 环境信息 -->
  <view class="card">
    <view class="flex-between" bindtap="toggleDetails">
      <text class="card-title">环境信息</text>
      <text class="tiny muted">{{detailsOpen ? '收起' : '展开'}}</text>
    </view>

    <view wx:if="{{detailsOpen}}" class="details">
      <view class="detail-row">
        <text class="tiny muted">运行环境</text>
        <text class="tiny">{{envLabel}}</text>
      </view>
      <view class="detail-row" bindtap="onCopyBaseUrl">
        <text class="tiny muted">服务地址</text>
        <text class="tiny ellipsis detail-value">{{baseUrl}}</text>
      </view>
      <view class="detail-row">
        <text class="tiny muted">服务时间</text>
        <text class="tiny">{{serverTime || '—'}}</text>
      </view>
      <view class="detail-row">
        <text class="tiny muted">客户端版本</text>
        <text class="tiny">{{version}}</text>
      </view>
    </view>
  </view>

  <!-- 退出 -->
  <view class="btn btn-danger logout" bindtap="onLogout">退出登录</view>

  <text class="tiny muted footer">样本任务台 · 内部工具</text>
  <view class="safe-bottom"></view>
</view>
