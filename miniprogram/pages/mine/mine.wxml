<view class="page">
  <view class="masthead">
    <text class="masthead-title">我的</text>
  </view>

  <!-- 账号与服务状态 -->
  <view class="sheet account">
    <view class="row">
      <view class="avatar" aria-hidden="true"><text>样</text></view>
      <view class="grow">
        <text class="account-name">{{isAdmin ? '管理员' : '业务账号'}}</text>
        <text class="account-id">{{openidMasked}}</text>
      </view>
    </view>
    <view class="row health health-{{health === null ? 'pending' : (health ? 'ok' : 'bad')}}" bindtap="checkHealth">
      <view class="health-dot"></view>
      <text class="grow">{{healthText}}</text>
      <text class="health-retry">{{health === false ? '重新检测' : ''}}</text>
    </view>
  </view>

  <!-- 我的任务：点数字直接跳到对应筛选 -->
  <view class="section-head">
    <text class="section-title">我的任务</text>
  </view>
  <view class="sheet stats">
    <view
      wx:for="{{statCards}}"
      wx:key="key"
      class="stat"
      hover-class="stat-press"
      bindtap="onStatTap"
      data-key="{{item.key}}"
    >
      <text class="stat-value {{item.key === 'issue' && item.value > 0 ? 'stat-bad' : ''}}">{{item.value}}</text>
      <text class="stat-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 常见问题 -->
  <view class="section-head">
    <text class="section-title">常见问题</text>
  </view>
  <view class="sheet faq">
    <view
      wx:for="{{faq}}"
      wx:key="q"
      class="faq-item {{faqOpenIndex === index ? 'faq-open' : ''}}"
      bindtap="onFaqTap"
      data-index="{{index}}"
    >
      <view class="row faq-q">
        <text class="grow">{{item.q}}</text>
        <view class="faq-chevron" aria-hidden="true"></view>
      </view>
      <text wx:if="{{faqOpenIndex === index}}" class="faq-a">{{item.a}}</text>
    </view>
  </view>

  <!-- 环境信息：排查问题时才看 -->
  <view class="sheet env">
    <view class="row env-head" bindtap="toggleDetails">
      <text class="grow env-title">环境信息</text>
      <text class="env-sign">{{detailsOpen ? '收起' : '展开'}}</text>
    </view>
    <view wx:if="{{detailsOpen}}" class="env-body">
      <view class="row kv">
        <text class="grow">运行环境</text>
        <text>{{envLabel}}</text>
      </view>
      <view class="row kv">
        <text class="grow">运行版本</text>
        <text>{{envVersion}}</text>
      </view>
      <view class="row kv" bindtap="onCopyBaseUrl">
        <text class="kv-key">服务地址</text>
        <text class="grow kv-link ellipsis">{{baseUrl}}</text>
      </view>
      <view class="row kv">
        <text class="grow">服务器时间</text>
        <text>{{serverTime || '未取到'}}</text>
      </view>
      <view class="row kv">
        <text class="grow">客户端版本</text>
        <text>{{version}}</text>
      </view>
    </view>
  </view>

  <view class="btn btn-danger logout" hover-class="btn-press" bindtap="onLogout">退出登录</view>
  <text class="footer">样本任务台，内部工具</text>
</view>
