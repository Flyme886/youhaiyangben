/* ---------- 选文件 ---------- */

.drop {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx 56rpx;
  border: 3rpx dashed var(--rule-strong);
  border-radius: 24rpx;
  background: var(--sheet);
}

.drop-press {
  border-color: var(--accent);
  background: var(--accent-wash);
}

/* 一张折角的表格纸 */
.drop-sheet {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 120rpx;
  height: 150rpx;
  padding-bottom: 18rpx;
  border-radius: 10rpx;
  background: var(--accent);
  overflow: hidden;
}

.drop-fold {
  position: absolute;
  top: 0;
  right: 0;
  width: 38rpx;
  height: 38rpx;
  background: linear-gradient(225deg, var(--paper) 50%, var(--accent-press) 50%);
}

.drop-ext {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #ffffff;
}

.drop-title {
  margin-top: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.drop-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.howto {
  margin-top: 28rpx;
  padding: 0 8rpx;
}

.howto-step {
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
}

.howto-no {
  flex-shrink: 0;
  width: 40rpx;
  font-family: var(--serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--accent);
}

/* ---------- 已选文件 ---------- */

.picked {
  position: relative;
  padding: 0;
  overflow: hidden;
}

.picked-uploading {
  border-color: var(--accent);
}

.picked-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  background: var(--accent-wash);
  transition: width 0.3s ease;
}

.picked-row {
  position: relative;
  gap: 24rpx;
  padding: 30rpx 32rpx;
}

.picked-book {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 80rpx;
  padding-bottom: 10rpx;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  border-left: 8rpx solid var(--accent-press);
  background: var(--accent);
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 700;
}

.picked-name {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.picked-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.picked-uploading .picked-meta {
  color: var(--accent);
  font-weight: 600;
}

.picked-swap {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 16rpx;
  font-size: 26rpx;
  color: var(--accent);
}

.error {
  margin-top: 24rpx;
}

.form {
  margin-top: 24rpx;
}

/* ---------- 流程说明 ---------- */

.after {
  margin-top: 24rpx;
  padding: 0 32rpx;
}

.after-head {
  padding: 30rpx 0;
}

.after-title {
  font-size: 27rpx;
  color: var(--ink-2);
}

.after-sign {
  font-size: 24rpx;
  color: var(--accent);
}

.after-body {
  padding-bottom: 30rpx;
}

.after-step {
  align-items: flex-start;
  padding: 8rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.after-no {
  flex-shrink: 0;
  width: 40rpx;
  font-weight: 700;
  color: var(--accent);
}

.after-tail {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--muted);
}

@media (prefers-reduced-motion: reduce) {
  .picked-fill {
    transition: none;
  }
}
