.new-task-page {
  padding-bottom: 184rpx;
}

.upload-section {
  padding-top: 0;
}

/* ---------------- 文件选择 ---------------- */
.picker {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 26rpx;
  padding: 52rpx 28rpx;
  border-radius: 22rpx;
  background: #f5f5f7;
  transition: opacity 0.18s ease, background 0.18s ease;
}

.picker-hover {
  background: #ececf0;
}

.picker-plus {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 22rpx;
  border-radius: 50%;
  background: #ffffff;
}

.plus-h,
.plus-v {
  position: absolute;
  border-radius: 3rpx;
  background: #1d6f5f;
}

.plus-h {
  left: 20rpx;
  top: 34rpx;
  width: 32rpx;
  height: 4rpx;
}

.plus-v {
  left: 34rpx;
  top: 20rpx;
  width: 4rpx;
  height: 32rpx;
}

.picker-text {
  color: #1d6f5f;
  font-size: 29rpx;
  font-weight: 600;
}

.picker-hint {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: center;
}

/* ---------------- 已选文件 ---------------- */
.file-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #edf6f3;
}

.file-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1d6f5f;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.file-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.file-name {
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 600;
}

.file-remove {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 16rpx;
  color: #c43c3c;
  font-size: 25rpx;
}

/* ---------------- 表单 ---------------- */
.field-last {
  margin-bottom: 0;
}

/* ---------------- 流程说明 ---------------- */
.guide-body {
  margin-top: 26rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.guide-no {
  flex-shrink: 0;
  width: 40rpx;
  margin-right: 14rpx;
  color: #1d6f5f;
  font-size: 24rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.guide-text {
  color: #1c1c1e;
  font-size: 27rpx;
}

.guide-tail {
  display: block;
  margin-top: 24rpx;
  color: #6e6e73;
  line-height: 1.65;
}

/* ---------------- 进度 / 错误 ---------------- */
.progress-card {
  border-bottom: 0;
}

.progress {
  height: 6rpx;
  margin: 24rpx 0;
  overflow: hidden;
  border-radius: 3rpx;
  background: #ececf0;
}

.progress-bar {
  height: 100%;
  border-radius: 3rpx;
  background: #1d6f5f;
  transition: width 0.25s ease;
}

.cancel-btn {
  width: 100%;
}

.error-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 0;
  border-radius: 18rpx;
  background: #fff1f1;
}

.error-card .error-text {
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---------------- 固定提交动作 ---------------- */
.submit {
  position: fixed;
  z-index: 20;
  right: 32rpx;
  bottom: calc(24rpx + constant(safe-area-inset-bottom));
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  width: auto;
  margin: 0;
}
