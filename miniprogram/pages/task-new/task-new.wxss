.intro {
  padding: 32rpx 8rpx 40rpx;
}

/* ---------- 选文件 ---------- */

.pick {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 40rpx 64rpx;
}

/* 一张表格纸：折角 + 3×3 格子 */
.sheet-art {
  position: relative;
  width: 132rpx;
  height: 160rpx;
  padding: 44rpx 20rpx 0;
  border-radius: 14rpx;
  background: var(--primary);
  overflow: hidden;
}

.sheet-art-corner {
  position: absolute;
  top: 0;
  right: 0;
  width: 34rpx;
  height: 34rpx;
  border-bottom-left-radius: 8rpx;
  background: rgba(255, 255, 255, 0.3);
}

.sheet-art-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6rpx;
}

.sheet-art-cell {
  height: 22rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.85);
}

.pick-title {
  margin-top: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.pick-hint {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.howto {
  padding: 32rpx 8rpx 0;
}

.howto-step {
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

.howto-n {
  flex-shrink: 0;
  width: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

/* ---------- 已选文件 ---------- */

.picked {
  position: relative;
  overflow: hidden;
}

.picked-fill {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  background: var(--primary-wash);
  transition: width 0.3s ease;
}

.picked-row {
  position: relative;
  gap: 26rpx;
  padding: 32rpx;
}

.xls {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 84rpx;
  padding-bottom: 12rpx;
  border-radius: 10rpx;
  background: var(--primary);
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 700;
}

.picked-name {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.picked-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.picked-busy .picked-meta {
  color: var(--primary);
  font-weight: 600;
}

.picked-swap {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 20rpx;
  font-size: 26rpx;
  color: var(--primary);
}

.error {
  margin-top: 24rpx;
}

.form {
  margin-top: 24rpx;
}

/* ---------- 流程说明 ---------- */

.after {
  margin-top: 24rpx;
}

.after-step {
  align-items: flex-start;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
}

.after-tail {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--muted);
}

@media (prefers-reduced-motion: reduce) {
  .picked-fill {
    transition: none;
  }
}
