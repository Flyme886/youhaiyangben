<view class="page {{dock.show ? 'page-with-bar' : ''}}">
  <!-- 加载中 -->
  <block wx:if="{{loading}}">
    <view class="head">
      <view class="skeleton sk-name"></view>
      <view class="skeleton sk-sub"></view>
    </view>
    <view class="panel panel-pad"><view class="skeleton sk-hero"></view></view>
  </block>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="head">
    <view class="notice notice-bad">{{loadError}}</view>
    <view class="btn btn-soft btn-sm back-btn" hover-class="btn-press" bindtap="onBack">回到任务列表</view>
  </view>

  <block wx:else>
    <!-- 标题 -->
    <view class="head">
      <text class="name">{{task.name || '未命名任务'}}</text>
      <view class="row head-meta">
        <status-tag status="{{task.status}}" />
        <text class="head-when">{{createdText}} 提交</text>
      </view>
      <text wx:if="{{task.note}}" class="head-note">{{task.note}}</text>
    </view>

    <!-- 进行中：现在在做什么 + 时间线 -->
    <view wx:if="{{live}}" class="panel panel-pad">
      <text class="now">{{stepText}}</text>
      <text class="now-sub">{{task.status === 'queued' ? '前面还有任务，轮到它时会自动开始' : '第 ' + stepNo + ' 步，共 4 步'}}</text>
      <view class="track now-track {{task.status === 'running' ? 'track-live' : ''}}">
        <view class="track-fill" style="width: {{progress}}%"></view>
      </view>
      <text class="now-foot">{{durationText ? '已运行 ' + durationText + '，' : ''}}关掉小程序也会继续</text>

      <view class="steps">
        <view wx:for="{{steps}}" wx:key="key" class="step step-{{item.state}}">
          <view class="step-rail">
            <view class="step-dot"></view>
            <view wx:if="{{index !== steps.length - 1}}" class="step-line"></view>
          </view>
          <view class="grow step-body">
            <text class="step-label">{{item.label}}</text>
            <text class="step-hint">{{item.hint}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 已结束：样本格 -->
    <view wx:else class="panel panel-pad">
      <block wx:if="{{coverage}}">
        <view class="figure">
          <text class="figure-n">{{coverage.got}}</text>
          <text class="figure-of">/ {{coverage.total}} 条拿到了页面截图</text>
        </view>

        <view class="grid {{gridAnimate ? 'grid-reveal' : ''}}" aria-label="截图覆盖 {{coverage.percent}}%">
          <view
            wx:for="{{grid.cells}}"
            wx:key="i"
            class="cell cell-{{item.g}}"
            style="{{gridAnimate ? 'animation-delay: ' + item.i * 6 + 'ms' : ''}}"
          ></view>
        </view>
        <text wx:if="{{grid.per > 1}}" class="grid-note">每格约 {{grid.per}} 条</text>

        <view class="legend">
          <view wx:for="{{coverage.segments}}" wx:key="key" class="row legend-row">
            <view class="swatch cell-{{item.group}}"></view>
            <text class="grow">{{item.label}}</text>
            <text class="legend-n">{{item.count}}</text>
          </view>
        </view>
      </block>

      <!-- 没有截图统计（老任务或早早失败）：退回到文字 -->
      <block wx:else>
        <text class="figure-plain">{{task.docx_count > 0 ? 'Word ' + task.docx_count + ' 册' : '没有产出 Word'}}</text>
        <text wx:if="{{task.issue_count > 0}}" class="figure-sub">其中 {{task.issue_count}} 条缺图</text>
      </block>

      <text class="verdict">{{statusHint}}</text>
    </view>

    <!-- 交付说明 -->
    <view wx:if="{{errorList.length > 0}}" class="notice notice-warn issues">
      <text wx:for="{{errorList}}" wx:key="*this" class="issue">{{item}}</text>
    </view>

    <!-- 结果文件 -->
    <view class="group-head">
      <text class="group-title">结果文件</text>
      <text wx:if="{{files.length > 1}}" class="group-aside">{{files.length}} 个</text>
    </view>
    <view wx:if="{{files.length > 0}}" class="panel">
      <view
        wx:for="{{files}}"
        wx:key="name"
        class="line-row file"
        hover-class="row-press"
        hover-stay-time="60"
        bindtap="onFileTap"
        data-name="{{item.name}}"
      >
        <view class="doc doc-{{item.kind}}" aria-hidden="true">
          <view class="doc-corner"></view>
          <text class="doc-ext">{{item.extLabel}}</text>
        </view>
        <view class="grow">
          <text class="file-name ellipsis">{{item.name}}</text>
          <text class="file-meta">{{item.sizeText}}</text>
        </view>
        <text class="file-act">{{item.previewable ? '打开' : '转发'}}</text>
      </view>
    </view>
    <view wx:else class="panel panel-pad files-empty">
      {{live ? '每一册 Word 生成后会出现在这里' : '这次没有可下载的文件'}}
    </view>

    <!-- 结案结论 -->
    <block wx:if="{{conclusion}}">
      <view class="group-head">
        <text class="group-title">结案结论</text>
      </view>
      <view class="panel panel-pad">
        <text class="conclusion">{{conclusion}}</text>
      </view>
    </block>

    <!-- 低频信息 -->
    <view class="panel folds">
      <block wx:if="{{!live}}">
        <view class="fold-head" bindtap="toggleSteps">
          <text class="fold-title">处理过程</text>
          <view class="chevron {{stepsOpen ? 'chevron-open' : ''}}"></view>
        </view>
        <view wx:if="{{stepsOpen}}" class="fold-body">
          <view wx:for="{{steps}}" wx:key="key" class="kv">
            <text class="kv-key">第 {{index + 1}} 步</text>
            <text class="grow">{{item.label}}</text>
            <text class="{{item.state === 'done' ? '' : 'muted'}}">{{item.state === 'done' ? '完成' : '未进行'}}</text>
          </view>
          <block wx:if="{{quality.length > 0}}">
            <text class="fold-sub">截图检查</text>
            <view wx:for="{{quality}}" wx:key="key" class="kv">
              <text class="grow">{{item.label}}</text>
              <text>{{item.count}}</text>
            </view>
          </block>
        </view>
        <view class="fold-split"></view>
      </block>

      <view class="fold-head" bindtap="toggleTech">
        <text class="fold-title">技术信息</text>
        <view class="chevron {{techOpen ? 'chevron-open' : ''}}"></view>
      </view>
      <view wx:if="{{techOpen}}" class="fold-body">
        <view class="kv" bindtap="onCopyId">
          <text class="kv-key">任务编号</text>
          <text class="kv-val kv-link">{{task.id}}</text>
        </view>
        <view class="kv">
          <text class="kv-key">提交时间</text>
          <text class="kv-val">{{createdFull}}</text>
        </view>
        <view wx:if="{{finishedFull}}" class="kv">
          <text class="kv-key">结束时间</text>
          <text class="kv-val">{{finishedFull}}</text>
        </view>
        <view wx:if="{{durationText}}" class="kv">
          <text class="kv-key">耗时</text>
          <text class="kv-val">{{durationText}}</text>
        </view>
        <view wx:if="{{logTail}}" class="log">
          <text class="log-text" user-select="{{true}}">{{logTail}}</text>
        </view>
        <view wx:if="{{logTail}}" class="btn btn-ghost btn-sm log-copy" hover-class="btn-press" bindtap="onCopyLog">复制日志</view>
      </view>
    </view>
  </block>

  <!-- 底栏：当前状态下最该做的一两件事 -->
  <view wx:if="{{dock.show}}" class="dock">
    <view wx:if="{{dock.cancel}}" class="btn btn-danger" hover-class="btn-press" bindtap="onCancel">取消任务</view>
    <view
      wx:if="{{dock.resume}}"
      class="btn {{dock.open ? 'btn-soft' : 'btn-primary'}}"
      hover-class="btn-press"
      bindtap="onResume"
    >{{busy ? '请稍候' : dock.resumeText}}</view>
    <view wx:if="{{dock.open}}" class="btn btn-primary" hover-class="btn-press" bindtap="onOpenPrimary">打开 Word</view>
  </view>
</view>
