/* ---------- 标题 ---------- */

.head {
  padding: 32rpx 8rpx 40rpx;
}

.name {
  display: block;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
  color: var(--ink);
  word-break: break-all;
}

.head-meta {
  margin-top: 20rpx;
}

.head-when {
  margin-left: 24rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.head-note {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-2);
}

/* ---------- 进行中 ---------- */

.now {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
}

.now-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.now-track {
  margin-top: 32rpx;
}

.now-foot {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.steps {
  margin-top: 40rpx;
  padding-top: 36rpx;
  border-top: 1rpx solid var(--line);
}

.step {
  display: flex;
}

.step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
  margin-right: 24rpx;
  padding-top: 12rpx;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-shadow: inset 0 0 0 3rpx var(--line-strong);
}

.step-line {
  flex: 1;
  width: 3rpx;
  margin: 8rpx 0 4rpx;
  border-radius: 2rpx;
  background: var(--line);
}

.step-done .step-dot {
  background: var(--primary);
  box-shadow: none;
}

.step-done .step-line {
  background: var(--primary);
}

.step-doing .step-dot {
  box-shadow: inset 0 0 0 6rpx var(--primary), 0 0 0 8rpx var(--primary-wash);
}

.step-body {
  padding-bottom: 32rpx;
}

.step-label {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
}

.step-done .step-label {
  color: var(--ink);
}

.step-doing .step-label {
  color: var(--primary);
  font-weight: 600;
}

.step-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--faint);
}

.step-doing .step-hint {
  color: var(--muted);
}

/* ---------- 已结束：数字 + 样本格 ---------- */

.figure {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.figure-n {
  margin-right: 14rpx;
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -2rpx;
  color: var(--ink);
}

.figure-of {
  font-size: 27rpx;
  color: var(--ink-2);
}

.figure-plain {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
}

.figure-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--blocked-ink);
}

/* 20 列。每格一条样本（或 N 条） */
.grid {
  display: grid;
  grid-template-columns: repeat(20, 1fr);
  gap: 6rpx;
  margin-top: 36rpx;
}

.cell {
  height: 24rpx;
  border-radius: 5rpx;
}

.cell-got {
  background: var(--got);
}

.cell-blocked {
  background: var(--blocked);
}

.cell-broken {
  background: var(--broken);
}

/* 全页唯一一次主动动效：格子依次点亮 */
.grid-reveal .cell {
  animation: cell-in 260ms ease-out both;
}

@keyframes cell-in {
  from {
    opacity: 0;
    transform: scale(0.4);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .grid-reveal .cell {
    animation: none;
  }
}

.grid-note {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
  text-align: right;
}

.legend {
  margin-top: 28rpx;
}

.legend-row {
  padding: 10rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
}

.swatch {
  width: 20rpx;
  height: 20rpx;
  margin-right: 18rpx;
  border-radius: 5rpx;
}

.legend-n {
  font-weight: 600;
  color: var(--ink);
}

.verdict {
  display: block;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  font-size: 25rpx;
  line-height: 1.6;
  color: var(--muted);
}

/* ---------- 交付说明 ---------- */

.issues {
  margin-top: 20rpx;
}

.issue {
  display: block;
}

.issue + .issue {
  margin-top: 12rpx;
}

/* ---------- 文件 ---------- */

.file {
  gap: 26rpx;
}

/* 文件图标：带折角的一页纸，Word 墨绿、其它灰 */
.doc {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 68rpx;
  height: 84rpx;
  padding-bottom: 12rpx;
  border-radius: 10rpx;
  background: var(--primary);
  overflow: hidden;
}

.doc-pack {
  background: #9aa1a7;
}

.doc-corner {
  position: absolute;
  top: 0;
  right: 0;
  width: 22rpx;
  height: 22rpx;
  border-bottom-left-radius: 6rpx;
  background: rgba(255, 255, 255, 0.35);
}

.doc-ext {
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
}

.file-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.file-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.file-act {
  flex-shrink: 0;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--primary);
}

.files-empty {
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
}

/* ---------- 结论 ---------- */

.conclusion {
  font-size: 28rpx;
  line-height: 1.85;
  color: var(--ink);
}

/* ---------- 折叠 ---------- */

.folds {
  margin-top: 48rpx;
}

.fold-split {
  height: 1rpx;
  margin: 0 32rpx;
  background: var(--line);
}

.fold-sub {
  display: block;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 23rpx;
  color: var(--muted);
}

.log {
  max-height: 520rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #1d2329;
  overflow-y: scroll;
}

.log-text {
  font-family: var(--mono);
  font-size: 20rpx;
  line-height: 1.65;
  color: #cbd3cf;
  white-space: pre-wrap;
  word-break: break-all;
}

.log-copy {
  width: 200rpx;
  margin-top: 20rpx;
}

/* ---------- 加载 ---------- */

.sk-name {
  width: 72%;
  height: 50rpx;
}

.sk-sub {
  width: 36%;
  height: 26rpx;
  margin-top: 22rpx;
}

.sk-hero {
  height: 240rpx;
}

.back-btn {
  width: 260rpx;
  margin-top: 24rpx;
}
