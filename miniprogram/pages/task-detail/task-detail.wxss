/* ---------------- 概览 ---------------- */
.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.task-name {
  flex: 1;
  font-size: 36rpx;
  font-weight: 600;
  color: #1d2522;
  line-height: 1.35;
}

.status-hint {
  display: block;
  margin-top: 10rpx;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  background: #f4f1e9;
  border-radius: 10rpx;
}

.meta-hover {
  background: #ece7dd;
}

.copy-tip {
  color: #1d6f5f;
}

.progress {
  height: 12rpx;
  border-radius: 6rpx;
  background: #ece7dd;
  overflow: hidden;
  margin-top: 24rpx;
}

.progress-bar {
  height: 100%;
  border-radius: 6rpx;
  background: #1d6f5f;
  transition: width 0.4s ease;
}

.bar-live {
  background: linear-gradient(90deg, #1d6f5f 0%, #3f9a83 100%);
}

.meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* ---------------- 步骤流 ---------------- */
.steps {
  margin-top: 26rpx;
}

.step {
  display: flex;
  align-items: flex-start;
}

.step-rail {
  width: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 6rpx;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #ded8cb;
  border: 3rpx solid #f7f4ee;
  box-sizing: content-box;
}

.dot-done {
  background: #256a43;
}

.dot-doing {
  background: #1d6f5f;
  animation: dot-pulse 1.3s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(29, 111, 95, 0.35);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(29, 111, 95, 0);
  }
}

.step-line {
  width: 3rpx;
  flex: 1;
  min-height: 48rpx;
  background: #ded8cb;
  margin: 4rpx 0;
}

.line-done {
  background: #a8c9b4;
}

.step-body {
  flex: 1;
  padding: 0 0 28rpx 20rpx;
}

.step-label {
  display: block;
  font-size: 28rpx;
  color: #b4b2a9;
  line-height: 1.4;
}

.label-done {
  color: #1d2522;
}

.label-doing {
  color: #1d6f5f;
  font-weight: 600;
}

.step-current {
  display: block;
  padding-top: 18rpx;
  border-top: 1rpx dashed #d8d2c6;
}

/* ---------------- 指标 ---------------- */
.metrics {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.metric {
  flex: 1;
  background: #fffdf7;
  border: 1rpx solid #d8d2c6;
  border-radius: 16rpx;
  padding: 22rpx 18rpx;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.metric-label {
  font-size: 22rpx;
  color: #66736e;
}

.metric-value {
  margin-top: 10rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: #1d2522;
  line-height: 1.1;
}

.metric-value-sm {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  word-break: break-all;
}

.value-warn {
  color: #9b4a20;
}

/* ---------------- 操作 ---------------- */
.actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

/* ---------------- 异常提示 ---------------- */
.warn-card {
  background: #fbf0e7;
  border-color: #e0b799;
}

.warn-item {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.warn-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #9b4a20;
  margin: 12rpx 16rpx 0 0;
  flex-shrink: 0;
}

.warn-text {
  flex: 1;
  font-size: 26rpx;
  color: #6d3a1a;
  line-height: 1.6;
}

/* ---------------- 采集状态 ---------------- */
.group-label {
  display: block;
  margin-top: 22rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.chip {
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e0b799;
  background: #fbf0e7;
  color: #9b4a20;
}

.chip-ok {
  border-color: #a8c9b4;
  background: #eaf3ec;
  color: #256a43;
}

/* ---------------- 文件 ---------------- */
.file-list {
  margin-top: 22rpx;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #ece7dd;
}

.file-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.file-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.file-doc {
  background: #1d6f5f;
}

.file-zip {
  background: #66736e;
}

.file-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.file-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #1d2522;
}

.file-action {
  font-size: 25rpx;
  font-weight: 600;
  color: #1d6f5f;
  padding: 8rpx 16rpx;
  border: 1rpx solid #1d6f5f;
  border-radius: 10rpx;
  flex-shrink: 0;
}

.empty-inline {
  padding: 36rpx 0 12rpx;
  text-align: center;
}

/* ---------------- 日志 ---------------- */
.log-box {
  margin-top: 22rpx;
  padding: 22rpx;
  background: #202823;
  border-radius: 12rpx;
  max-height: 640rpx;
  overflow-y: auto;
}

.log-text {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 21rpx;
  line-height: 1.7;
  color: #dfe8e1;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy-btn {
  margin-top: 22rpx;
  width: 100%;
}

/* ---------------- 骨架 / 错误 ---------------- */
.sk-title {
  height: 40rpx;
  width: 60%;
  margin-bottom: 20rpx;
}

.sk-sub {
  height: 22rpx;
  width: 40%;
  margin-bottom: 26rpx;
}

.sk-bar {
  height: 12rpx;
  width: 100%;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
  padding: 56rpx 28rpx;
}
