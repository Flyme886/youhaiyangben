/* ---------------- 当前状态 ---------------- */
.overview {
  padding-top: 20rpx;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.task-name {
  flex: 1;
  color: #1c1c1e;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: -0.5rpx;
}

.status-hint {
  display: block;
  margin-top: 12rpx;
  line-height: 1.55;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  padding: 10rpx 0;
}

.meta-hover {
  opacity: 0.55;
}

.copy-tip {
  flex-shrink: 0;
  color: #1d6f5f;
}

.progress {
  height: 6rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 3rpx;
  background: #ececf0;
}

.progress-bar {
  height: 100%;
  border-radius: 3rpx;
  background: #1d6f5f;
  transition: width 0.25s ease;
}

.bar-live {
  background: #1d6f5f;
}

.meta-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

/* ---------------- 操作 ---------------- */
.actions {
  display: flex;
  gap: 18rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

/* ---------------- 结果文件 ---------------- */
.file-list {
  margin-top: 16rpx;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eeeef2;
}

.file-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.file-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.file-doc {
  background: #edf6f3;
  color: #1d6f5f;
}

.file-zip {
  background: #f5f5f7;
  color: #6e6e73;
}

.file-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.file-name {
  color: #1c1c1e;
  font-size: 27rpx;
  font-weight: 500;
}

.file-action {
  flex-shrink: 0;
  padding: 12rpx 0 12rpx 16rpx;
  color: #1d6f5f;
  font-size: 25rpx;
  font-weight: 600;
}

.empty-inline {
  padding: 32rpx 0 12rpx;
  text-align: left;
}

/* ---------------- 指标 ---------------- */
.metrics {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #e5e5ea;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.metric-label {
  color: #6e6e73;
  font-size: 22rpx;
}

.metric-value {
  margin-top: 12rpx;
  color: #1c1c1e;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.metric-value-sm {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  word-break: break-all;
}

/* ---------------- 步骤流 ---------------- */
.steps {
  margin-top: 28rpx;
}

.step {
  display: flex;
  align-items: flex-start;
}

.step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  width: 28rpx;
  padding-top: 8rpx;
}

.step-dot {
  box-sizing: content-box;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #d1d1d6;
}

.dot-done {
  background: #248a3d;
}

.dot-doing {
  background: #1d6f5f;
  animation: dot-pulse 1.5s ease-in-out infinite;
}

@keyframes dot-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(29, 111, 95, 0.22);
  }
  50% {
    box-shadow: 0 0 0 10rpx rgba(29, 111, 95, 0);
  }
}

.step-line {
  flex: 1;
  width: 2rpx;
  min-height: 52rpx;
  margin: 4rpx 0;
  background: #e5e5ea;
}

.line-done {
  background: #cfe8d6;
}

.step-body {
  flex: 1;
  padding: 0 0 30rpx 20rpx;
}

.step-label {
  display: block;
  color: #8e8e93;
  font-size: 28rpx;
  line-height: 1.4;
}

.label-done {
  color: #1c1c1e;
}

.label-doing {
  color: #1d6f5f;
  font-weight: 600;
}

.step-current {
  display: block;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e5ea;
  line-height: 1.55;
}

/* ---------------- 异常提示 ---------------- */
.warn-card {
  margin-top: 28rpx;
  padding: 26rpx;
  border: 0;
  border-radius: 20rpx;
  background: #fff7e8;
}

.warn-item {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.warn-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 16rpx 0 0;
  border-radius: 50%;
  background: #9a5b13;
}

.warn-text {
  flex: 1;
  color: #76501e;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---------------- 采集状态 ---------------- */
.group-label {
  display: block;
  margin-top: 24rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.chip {
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  background: #fff7e8;
  color: #9a5b13;
  font-size: 22rpx;
  line-height: 1;
}

.chip-ok {
  background: #f0f8f2;
  color: #248a3d;
}

/* ---------------- 技术日志 ---------------- */
.log-section {
  border-bottom: 0;
}

.log-box {
  max-height: 640rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  overflow-y: auto;
  border-radius: 16rpx;
  background: #f5f5f7;
}

.log-text {
  color: #48484a;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 21rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy-btn {
  width: 100%;
  margin-top: 22rpx;
}

/* ---------------- 骨架 / 错误 ---------------- */
.sk-title {
  width: 60%;
  height: 40rpx;
  margin-bottom: 20rpx;
}

.sk-sub {
  width: 40%;
  height: 22rpx;
  margin-bottom: 26rpx;
}

.sk-bar {
  width: 100%;
  height: 6rpx;
}

.error-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
  margin-top: 32rpx;
  padding: 40rpx 28rpx;
  border: 0;
  border-radius: 20rpx;
  background: #fff1f1;
}

/* ---------------- 结案结论 ---------------- */
.conclusion-text {
  display: block;
  margin-top: 10rpx;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-line;
  word-break: break-word;
}
