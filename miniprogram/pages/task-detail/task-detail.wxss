/* ---------- 标题 ---------- */

.detail-name {
  display: block;
  font-family: var(--serif);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
  word-break: break-all;
}

.detail-sub {
  margin-top: 18rpx;
}

.detail-when {
  margin-left: 18rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.detail-note {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

/* ---------- 主区：进行中 ---------- */

.hero-live {
  border-color: var(--accent);
  border-width: 2rpx;
}

.hero-step {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--accent);
}

.hero-step-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.hero-track {
  margin-top: 28rpx;
}

.hero-foot {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--muted);
}

/* 步骤时间线 */
.steps {
  margin-top: 36rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--rule);
}

.step {
  display: flex;
}

.step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 44rpx;
  margin-right: 22rpx;
}

.step-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--rule-strong);
  font-size: 22rpx;
  font-weight: 600;
  color: var(--muted);
  background: var(--sheet);
}

.step-line {
  flex: 1;
  width: 2rpx;
  min-height: 28rpx;
  margin: 6rpx 0;
  background: var(--rule);
}

.step-check {
  width: 18rpx;
  height: 10rpx;
  margin-top: -4rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
}

.step-done .step-mark {
  border-color: var(--accent);
  background: var(--accent);
}

.step-done .step-line {
  background: var(--accent);
}

.step-doing .step-mark {
  border-color: var(--accent);
  color: var(--accent);
  box-shadow: 0 0 0 8rpx var(--accent-wash);
}

.step-body {
  flex: 1;
  padding-bottom: 28rpx;
}

.step-label {
  display: block;
  font-size: 28rpx;
  line-height: 44rpx;
  color: var(--muted);
}

.step-done .step-label {
  color: var(--ink);
}

.step-doing .step-label {
  color: var(--accent);
  font-weight: 600;
}

.step-hint {
  display: block;
  font-size: 23rpx;
  color: var(--muted);
}

/* ---------- 主区：已结束 ---------- */

.hero-top {
  align-items: flex-start;
}

.cov-figure {
  display: flex;
  align-items: baseline;
}

.cov-got {
  font-family: var(--serif);
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.cov-total {
  margin-left: 10rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--muted);
}

.cov-plain {
  display: block;
  font-family: var(--serif);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.cov-caption {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--ink-2);
}

/* 取证条 */
.evidence {
  display: flex;
  height: 22rpx;
  margin-top: 40rpx;
  border-radius: 6rpx;
  overflow: hidden;
  background: var(--well);
}

.ev-seg + .ev-seg {
  border-left: 3rpx solid var(--sheet);
}

.ev-got {
  background: var(--ok);
}

.ev-blocked {
  background: #c99541;
}

.ev-broken {
  background: #aab3ae;
}

.ev-legend {
  margin-top: 20rpx;
}

.ev-row {
  padding: 10rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.ev-swatch {
  width: 18rpx;
  height: 18rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
}

.ev-count {
  font-weight: 600;
  color: var(--ink);
}

.hero-hint {
  display: block;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--rule);
  font-size: 24rpx;
  color: var(--muted);
}

/* ---------- 文件 ---------- */

.file-sheet {
  padding: 0;
  overflow: hidden;
}

.file-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 26rpx 32rpx;
}

.file-row + .file-row {
  border-top: 1rpx solid var(--rule);
}

.file-row-press {
  background: #f7f9f8;
}

/* 一册书：墨绿书脊 + 扩展名 */
.file-book {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 80rpx;
  padding-bottom: 10rpx;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  border-left: 8rpx solid var(--accent-press);
  background: var(--accent);
  color: #ffffff;
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.file-book-pack {
  border-left-color: #8d9792;
  background: #aab3ae;
}

.file-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink);
}

.file-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.file-action {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}

.file-empty {
  font-size: 25rpx;
  color: var(--muted);
  text-align: center;
}

/* ---------- 说明 / 结论 ---------- */

.issue-line {
  display: block;
}

.issue-line + .issue-line {
  margin-top: 12rpx;
}

.conclusion {
  font-family: var(--serif);
  font-size: 29rpx;
  line-height: 1.85;
  color: var(--ink);
}

/* ---------- 折叠区 ---------- */

.fold-sheet {
  margin-top: 40rpx;
  padding: 0 32rpx;
}

.fold + .fold {
  border-top: 1rpx solid var(--rule);
}

.fold-head {
  padding: 30rpx 0;
}

.fold-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.fold-sign {
  font-size: 24rpx;
  color: var(--accent);
}

.fold-body {
  padding-bottom: 28rpx;
}

.mini-step {
  padding: 10rpx 0;
  font-size: 25rpx;
  color: var(--ink-2);
}

.mini-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: var(--rule-strong);
}

.mini-done .mini-dot {
  background: var(--accent);
}

.mini-state {
  font-size: 22rpx;
  color: var(--muted);
}

.quality {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--rule);
}

.quality-title {
  display: block;
  margin-bottom: 6rpx;
  font-size: 23rpx;
  color: var(--muted);
}

.kv {
  padding: 10rpx 0;
  font-size: 24rpx;
  color: var(--ink-2);
}

.kv-link {
  color: var(--accent);
}

.log-box {
  max-height: 520rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: var(--ink);
  overflow-y: scroll;
}

.log-text {
  font-family: Menlo, 'SF Mono', Consolas, monospace;
  font-size: 20rpx;
  line-height: 1.6;
  color: #cfd8d3;
  white-space: pre-wrap;
  word-break: break-all;
}

.copy-btn {
  margin-top: 16rpx;
  width: 200rpx;
}

/* ---------- 状态 ---------- */

.sk-name {
  width: 70%;
  height: 48rpx;
}

.sk-sub {
  width: 36%;
  height: 26rpx;
  margin-top: 20rpx;
}

.sk-hero {
  height: 220rpx;
}

.load-error {
  padding-top: 40rpx;
}

.back-btn {
  margin-top: 24rpx;
  width: 260rpx;
}
