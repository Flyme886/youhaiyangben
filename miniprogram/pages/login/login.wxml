<view class="login">
  <view class="brand">
    <seal text="样本任务" tone="seal" size="lg" />
    <text class="brand-title">样本任务台</text>
    <text class="brand-sub">交一份表格，取回一册带截图的证据</text>
  </view>

  <view class="panel">
    <!-- 先告诉用户服务器连不连得上，别让网络问题看起来像登录失败 -->
    <view class="row probe probe-{{serverOk === null ? 'pending' : (serverOk ? 'ok' : 'bad')}}">
      <view class="probe-dot"></view>
      <text class="grow">{{serverMsg}}</text>
      <text wx:if="{{serverOk === false}}" class="probe-retry" bindtap="onRetryProbe">重新检测</text>
    </view>
    <view wx:if="{{serverDetail}}" class="notice notice-bad probe-detail">
      <text>{{serverDetail}}</text>
    </view>

    <button
      class="btn btn-primary login-main"
      hover-class="btn-press"
      loading="{{loading && mode === 'wechat'}}"
      disabled="{{loading}}"
      bindtap="onWechatLogin"
    >微信一键登录</button>

    <view wx:if="{{!passwordOpen}}" class="alt" bindtap="onOpenPassword">用访问密码登录</view>

    <view wx:else class="pwd">
      <input
        class="field-input"
        password="{{true}}"
        value="{{password}}"
        placeholder="后台访问密码"
        placeholder-class="placeholder"
        confirm-type="done"
        focus="{{passwordOpen}}"
        bindinput="onPasswordInput"
        bindconfirm="onPasswordLogin"
      />
      <button
        class="btn btn-quiet pwd-btn"
        hover-class="btn-press"
        loading="{{loading && mode === 'password'}}"
        disabled="{{loading}}"
        bindtap="onPasswordLogin"
      >用密码登录</button>
    </view>

    <view wx:if="{{error}}" class="notice notice-bad login-error">{{error}}</view>
  </view>

  <view class="footer">
    <text>{{envLabel}}，{{envVersion}}</text>
    <text class="ellipsis">{{baseUrl}}</text>
  </view>
</view>
