.login {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 120rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-title {
  margin-top: 56rpx;
  font-family: var(--serif);
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--ink);
}

.brand-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.panel {
  margin-top: 96rpx;
}

.probe {
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.probe-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--rule-strong);
}

.probe-ok .probe-dot {
  background: var(--ok);
}

.probe-bad {
  color: var(--bad);
}

.probe-bad .probe-dot {
  background: var(--bad);
}

.probe-retry {
  color: var(--accent);
}

.probe-detail {
  margin-bottom: 28rpx;
}

.panel .login-main {
  width: 100%;
}

.alt {
  margin-top: 36rpx;
  font-size: 26rpx;
  color: var(--accent);
  text-align: center;
}

.pwd {
  margin-top: 36rpx;
}

.pwd .pwd-btn {
  margin-top: 20rpx !important;
  width: 100%;
}

.login-error {
  margin-top: 24rpx;
}

.footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: auto;
  padding-top: 64rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--muted);
  max-width: 100%;
}
