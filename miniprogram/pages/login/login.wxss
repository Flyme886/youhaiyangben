.login-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 112rpx 40rpx 52rpx;
  background: #ffffff;
}

/* ---------- 品牌区 ---------- */
.brand {
  margin-bottom: 44rpx;
}

.brand-mark {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 32rpx;
  border-radius: 22rpx;
  background: #1d6f5f;
}

.bar {
  height: 6rpx;
  margin: 4rpx 0;
  border-radius: 3rpx;
  background: #ffffff;
}

.bar-a {
  width: 40rpx;
}

.bar-b {
  width: 50rpx;
}

.bar-c {
  width: 30rpx;
}

.brand-title {
  display: block;
  color: #1c1c1e;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.brand-sub {
  display: block;
  margin-top: 16rpx;
  color: #6e6e73;
  font-size: 26rpx;
  line-height: 1.6;
}

/* ---------- 连通性提示 ---------- */
.probe {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: #f5f5f7;
}

.probe-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #aeaeb2;
}

.probe-pending .probe-dot {
  background: #c7a15a;
  animation: probe-blink 1.4s ease-in-out infinite;
}

.probe-ok .probe-dot {
  background: #248a3d;
}

.probe-bad .probe-dot {
  background: #c43c3c;
}

@keyframes probe-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.probe-text {
  flex: 1;
  color: #6e6e73;
  font-size: 24rpx;
}

.probe-retry {
  padding-left: 16rpx;
  color: #1d6f5f;
  font-size: 24rpx;
  font-weight: 600;
}

.probe-detail {
  margin-top: -12rpx;
  margin-bottom: 28rpx;
}

.probe-detail .error-text {
  white-space: pre-wrap;
  word-break: break-all;
}

/* ---------- 登录表单：白底无浮层 ---------- */
.panel {
  padding: 0;
  border: 0;
  background: #ffffff;
}

.login-main {
  width: 100%;
}

.or {
  display: flex;
  align-items: center;
  margin: 36rpx 0 30rpx;
}

.or-line {
  flex: 1;
  height: 1rpx;
  background: #e5e5ea;
}

.or-text {
  padding: 0 20rpx;
  color: #8e8e93;
  font-size: 22rpx;
}

.error-box {
  margin-top: 26rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff1f1;
}

.error-box .error-text {
  font-size: 24rpx;
  line-height: 1.6;
}

/* ---------- 底部 ---------- */
.footer {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: auto;
  padding-top: 60rpx;
}
