# ══════════════════════════════════════════════════════════════════════
# 有害样本任务台 · 环境变量模板
#
# 用法：
#   cp .env.example .env
#   然后按下面注释逐项填写。
#
# .env 已在 .gitignore 中排除，**绝不要提交到仓库**。
# 本文件由 app/config.py 的 _load_dotenv() 读取，解析规则很简单：
#   KEY=VALUE，不剥离行内注释 —— 所以注释必须单独占一行，
#   不能写成 CAPTURE_ENGINE=playwright  # 说明（那样注释会被当成值的一部分）。
#
# 标 [必填] 的不填功能不可用；标 [可选] 的留空即用代码里的默认值。
# ══════════════════════════════════════════════════════════════════════


# ── 基础 ─────────────────────────────────────────────────────────────
# [必填] 网页后台访问密码，同时也是小程序「访问密码」兜底登录的口令
APP_PASSWORD=change-this-password

# [必填] SessionMiddleware 的签名密钥。生产环境请换成随机串：
#        python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=harmful-sample-web-local-secret

# [可选] 监听地址与端口。FastAPI 只绑 0.0.0.0:8787，由 nginx 反代对外
HOST=0.0.0.0
PORT=8787


# ── 路径（必须写绝对路径） ───────────────────────────────────────────
# ⚠️ TASK_ROOT 与 SKILL_DIR 写相对路径会踩坑：worker 的工作目录是 task_dir，
#    相对路径会被解析到 data/tasks/<task_id>/ 下面，任务一提交就报
#    can't open file '.../data/tasks/<id>/skills/harmful_sample/scripts/excel_to_word.py'
TASK_ROOT=/opt/harmful-sample-web/data/tasks
DATABASE_PATH=/opt/harmful-sample-web/data/app.db
SKILL_DIR=/opt/harmful-sample-web/skills/harmful_sample
STORAGE_STATE_PATH=/opt/harmful-sample-web/data/storage_state.json
PYTHON_BIN=/opt/harmful-sample-web/.venv/bin/python
NODE_BIN=/usr/bin/node


# ── 微信小程序 ───────────────────────────────────────────────────────
# 不配这一整段，小程序登录会失败，所有 /api/wx/* 请求都会挂。
# AppID / AppSecret 在「微信公众平台 → 开发管理 → 开发设置」里获取。
#
# ⚠️ AppSecret 是服务端凭据：只能存在于服务器 .env，绝不允许出现在
#    miniprogram/ 的任何文件里，也绝不允许提交到 Git。

# [必填] 小程序 AppID
WX_APP_ID=wxXXXXXXXXXXXXXXXX

# [必填] 小程序 AppSecret
WX_APP_SECRET=fill-in-from-mp-console

# [必填] token 签名密钥，必须与 SESSION_SECRET 不同，建议 32 位以上随机串
WX_TOKEN_SECRET=fill-in-with-random-32-chars

# [可选] token 有效期（秒），默认 7 天，与小程序端 storage 生命周期一致
WX_TOKEN_TTL=604800

# [可选] 是否保留「访问密码」兜底登录通道。
#        迁移期建议 true；小程序完全稳定后改 false，去掉这条可爆破的路径
WX_ALLOW_PASSWORD_LOGIN=true

# [可选] 是否把历史任务（网页/飞书创建、无 openid 归属）也展示给业务用户
WX_INCLUDE_LEGACY_TASKS=true


# ── 抓取引擎 ─────────────────────────────────────────────────────────
# [可选] playwright / drission。命中 DRISSION_DOMAINS 的域名会自动切 DrissionPage
CAPTURE_ENGINE=playwright

# [可选] desktop / mobile
CAPTURE_PROFILE=desktop

# [可选] 走 DrissionPage（反爬更强）的域名，逗号分隔
DRISSION_DOMAINS=xiaohongshu.com,weibo.com

# [可选] 无头模式。某些页面有头渲染更完整，排查时可设 false（服务器需装桌面环境）
CAPTURE_HEADLESS=true

# [可选] 是否截整页。设 false 只截首屏
CAPTURE_FULL_PAGE=true

# [可选] 自定义 Chromium 路径，留空用 Playwright 自带的那份
CHROMIUM_EXECUTABLE_PATH=

# [可选] 命中多少条验证码后暂停任务。1 = 一命中就停（最安全），调大可多跑几条
CAPTCHA_PAUSE_THRESHOLD=1

# [可选] 失败重试次数
CAPTURE_RETRIES=2

# [可选] 登录态文件多少天后视为过期（过期后 login_required 比例会明显上升）
STORAGE_STATE_MAX_AGE_DAYS=7

# [可选] 单任务内并发路数与随机间隔（越像人越慢，越容易被风控识别）
CAPTURE_BATCH_SIZE=3
CAPTURE_BATCH_DELAY_MIN_MS=1200
CAPTURE_BATCH_DELAY_MAX_MS=3000

# [可选] 出口代理，留空则回落到 HTTPS_PROXY
CAPTURE_PROXY=

# [可选] 自定义 User-Agent，留空用 Playwright 默认
CAPTURE_USER_AGENT=


# ── 任务调度 ─────────────────────────────────────────────────────────
# [可选] 单任务最长执行时间（秒），默认 2 小时
TASK_TIMEOUT_SECONDS=7200

# [可选] 任务级并发 worker 数。
#        内存占用 ≈ 任务数 × (1 个 chromium + CAPTURE_BATCH_SIZE 个页面)，
#        2C4G 轻量机不要超过 2；4G 以上可试 3
TASK_WORKERS=2


# ── 可选集成 ─────────────────────────────────────────────────────────
# [可选] /internal/* 接口的调用密钥（供外部机器人使用）。
#        留空表示**全部拒绝**（安全默认），不是「不校验」
BOT_API_KEY=

# [可选] 飞书机器人通知地址（该路线已废弃，留空即可）
FEISHU_BOT_NOTIFY_URL=
